# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# Leave TEMPORAL_API_KEY empty to use a local dev server (temporal server start-dev).
# Set it to connect to Temporal Cloud with API key authentication.

# --- Temporal Cloud (API key authentication) ---

# gRPC Namespace endpoint from the Namespaces tab in the Temporal Cloud UI.
# Recommended form (works for all namespaces, handles HA failover):
#     <namespace>.<account>.tmprl.cloud:7233
TEMPORAL_ADDRESS=

# The "<namespace_id>.<account_id>" combination, also shown on the Namespaces tab.
TEMPORAL_NAMESPACE=

# Generate one in the Temporal
# Cloud UI or with `tcld apikey create`. Keep this secret — never commit .env.
TEMPORAL_API_KEY=
# --- Optional ---

# Task Queue the worker and clients share. Defaults to "email-tasks".
TEMPORAL_TASK_QUEUE=email-tasks

# --- Local dev alternative ---
# To run against a local dev server instead, comment out the block above (or
# leave TEMPORAL_API_KEY empty) and use:
#     TEMPORAL_ADDRESS=localhost:7233
#     TEMPORAL_NAMESPACE=default
